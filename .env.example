# copy to backend/.env

# Stages that should return fixtures instead of running for real.
# Options: ingest,understand,trends,playbook,direct,render  or  all
USE_FIXTURES=all

# GMI Cloud (OpenAI-compatible). Confirm the base URL + model id from your credits email.
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_API_KEY=
GMI_MODEL=google/gemini-3.5-flash-lite

# Oriane. Verified: Authorization: Bearer <key>
ORIANE_API_KEY=
ORIANE_AUTH_HEADER=Authorization

# Compound.mov
COMPOUND_API_KEY=

# Where the UI can reach rendered clips
PUBLIC_BASE_URL=http://localhost:8000

# Optional, only for scripts/analyze_clip.py probes (video understanding)
GEMINI_API_KEY=
MINIMAX_API_KEY=
