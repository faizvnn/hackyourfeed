# copy to backend/.env

# Stages that should return fixtures instead of running for real.
# Options: ingest,understand,trends,playbook,direct,render  or  all
USE_FIXTURES=all

# GMI Cloud (OpenAI-compatible). Confirm the base URL + model id from your credits email.
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_API_KEY=
GMI_MODEL=google/gemini-3.5-flash-lite

# Oriane. Verified: Authorization: Bearer <key>
ORIANE_API_KEY=
ORIANE_AUTH_HEADER=Authorization

# Compound.mov
COMPOUND_API_KEY=

# Where the UI can reach rendered clips
PUBLIC_BASE_URL=http://localhost:8000

# Stage 6 engine: classic (default, Pillow overlays) or adaptive (experimental libass captions,
# see backend/RENDER.md). adaptive needs ffmpeg built with libass.
RENDER_ENGINE=classic
# Smart follows faces and fills 9:16 in both engines. Use static for legacy layout/crop knobs.
RENDER_FRAMING=smart
# adaptive-only knobs
# RENDER_LAYOUT=crop            crop (default) or blur
# RENDER_CROP_CENTER_X=0.5      horizontal crop centre, 0..1
# RENDER_TIMEOUT_SECONDS=300
# RENDER_FONT_NAME=DejaVu Sans  font family for libass
# RENDER_ENGINE=adaptive needs ffmpeg with libass. Homebrew's `ffmpeg` is a slim build without it;
# `brew install ffmpeg-full` (keg-only, not on PATH) and point these at it:
# FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# Optional, only for scripts/analyze_clip.py probes (video understanding)
GEMINI_API_KEY=
MINIMAX_API_KEY=
