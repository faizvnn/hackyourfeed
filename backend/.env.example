# Stage 6 requires no API keys. This URL must be reachable from the Lovable browser.
PUBLIC_BASE_URL=http://localhost:8000
RENDER_LAYOUT=crop
# 0.5 = center of the source frame; adjust if the speaker sits to one side.
RENDER_CROP_CENTER_X=0.5
RENDER_TIMEOUT_SECONDS=300
# Optional font family; defaults to Arial on Windows, DejaVu Sans on Linux.
# RENDER_FONT_NAME=DejaVu Sans
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# WORK_DIR=/absolute/path/to/work
